            }
          },
          "type": {
            "type": "string"
          }
        }
      },
      "CompanyContactBody": {
        "required": [
          "version"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "tradeName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "website": {
            "type": "string"
          }
        }
      },
      "CompanyFiscalBody": {
        "required": [
          "version",
          "fiscalYearStartMonth"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "fiscalYearStartMonth": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CompanyIdentityBody": {
        "required": [
          "version",
          "confirm",
          "legalNameTh",
          "taxId",
          "branchCode",
          "address"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "confirm": {
            "enum": [
              true
            ],
            "type": "boolean"
          },
          "legalNameTh": {
            "type": "string"
          },
          "taxId": {
            "type": "string"
          },
          "branchCode": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "legalNameEn": {
            "type": "string"
          },
          "registrationNo": {
            "type": "string"
          },
          "paidUpCapital": {
            "pattern": "^-?(0|[1-9][0-9]{0,15})\\.[0-9]{2}$",
            "type": "string"
          }
        }
      },
      "CompanyImagesBody": {
        "required": [
          "version"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "logoDataUrl": {
            "$ref": "#/components/schemas/OptionalOfstring"
          },
          "stampDataUrl": {
            "$ref": "#/components/schemas/OptionalOfstring"
          }
        }
      },
      "CompanyNotesBody": {
        "required": [
          "version",
          "defaultNotes"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "defaultNotes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "CompanyPayrollBody": {
        "required": [
          "version"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "ssoEmployerAccountNo": {
            "type": "string"
          }
        }
      },
      "CompanySectionBody": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/CompanyIdentityBody"
          },
          {
            "$ref": "#/components/schemas/CompanyContactBody"
          },
          {
            "$ref": "#/components/schemas/CompanyPayrollBody"
          },
          {
            "$ref": "#/components/schemas/CompanyFiscalBody"
          },
          {
            "$ref": "#/components/schemas/CompanyImagesBody"
          },
          {
            "$ref": "#/components/schemas/CompanyNotesBody"
          }
        ]
      },
      "CompanySettingsView": {
        "required": [
          "id",
          "legalNameTh",
          "taxId",
          "branchCode",
          "vatRegistered",
          "address",
          "fiscalYearStartMonth",
          "fiscalYearLocked"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "legalNameTh": {
            "type": "string"
          },
          "taxId": {
            "type": "string"
          },
          "branchCode": {
            "type": "string"
          },
          "vatRegistered": {
            "type": "boolean"
          },
          "address": {
            "type": "string"
          },
          "fiscalYearStartMonth": {
            "type": "integer",
            "format": "int32"
          },
          "fiscalYearLocked": {
            "type": "boolean"
          },
          "legalNameEn": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "ssoEmployerAccountNo": {
            "type": "string"
          },
          "registrationNo": {
            "type": "string"
          },
          "tradeName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "paidUpCapital": {
            "pattern": "^-?(0|[1-9][0-9]{0,15})\\.[0-9]{2}$",
            "type": "string"
          },
          "logoDataUrl": {
            "type": "string"
          },
          "stampDataUrl": {
            "type": "string"
          },
          "defaultNotes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
