  "components": {
    "schemas": {
      "ActiveBody": {
        "required": [
          "active",
          "version"
        ],
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ActiveCompanyBody": {
        "required": [
          "companyId"
